# RPA Environment Configuration
# Copy to `.env` and edit; never commit `.env`.
# All values are read via os.environ in rpa/settings.py

# =============================================================================
# MODE (required)
# =============================================================================
# Set to 'production' to enable production safeguards.
# Default: 'demo' (allows simulation, no auth required for local dev)
RPA_MODE=demo

# =============================================================================
# DATABASE (required for production)
# =============================================================================
# Full PostgreSQL connection string. Use a secret manager in production.
# Example: postgresql://user:pass@host:5432/dbname?sslmode=require
RPA_DATABASE_URL=postgresql://rpa:change_me@localhost:5432/rpa

# Connection pool settings
RPA_DB_POOL_MIN_SIZE=1
RPA_DB_POOL_MAX_SIZE=10
RPA_DB_POOL_ACQUIRE_TIMEOUT_SECONDS=5

# =============================================================================
# AUTHENTICATION (required for production)
# =============================================================================
# HS256 signing key for JWT access tokens. Minimum 32 characters.
# Generate with: openssl rand -base64 32
RPA_AUTH_SIGNING_KEY=replace_with_a_32_character_minimum_random_secret

# JWT issuer claim
RPA_AUTH_ISSUER=rpa

# Access token TTL in seconds (60-86400)
RPA_ACCESS_TOKEN_TTL_SECONDS=900

# =============================================================================
# WEBHOOK SECURITY (required for production)
# =============================================================================
# HMAC secret for webhook signature verification. Minimum 32 characters.
# Generate with: openssl rand -base64 32
RPA_WEBHOOK_SIGNING_SECRET=replace_with_a_32_character_minimum_random_secret

# Timestamp tolerance in seconds for replay protection (default 300 = 5 min)
RPA_WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# =============================================================================
# CORS (required for production)
# =============================================================================
# Comma-separated list of allowed origins. NO wildcards (*) allowed in production.
RPA_CORS_ORIGINS=http://localhost:5173

# =============================================================================
# REQUEST LIMITS
# =============================================================================
# Maximum request body size in bytes
RPA_REQUEST_MAX_BYTES=1048576

# =============================================================================
# MODEL ARTIFACT
# =============================================================================
# Path to frozen model artifact directory
RPA_MODEL_ARTIFACT_PATH=artifacts/models/rpa-recovery-logreg-full-v1

# =============================================================================
# DEMO DATA
# =============================================================================
# Path to demo data directory (used in demo mode only)
RPA_DEMO_DATA_PATH=data

# =============================================================================
# LEGACY (deprecated - use RPA_DATABASE_URL instead)
# =============================================================================
# These are only used by the data pipeline scripts, not the API server.
RPA_DB_HOST=localhost
RPA_DB_PORT=5432
RPA_DB_NAME=rpa
RPA_DB_USER=rpa
RPA_DB_PASSWORD=change_me_or_leave_blank
RPA_DB_SCHEMA=rpa