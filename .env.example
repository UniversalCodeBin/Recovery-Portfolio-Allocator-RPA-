# PostgreSQL connection for Step 1 DB loading.
# Copy to `.env` and edit; never commit `.env`. Read via os.environ in
# data_core/config.py. Leave DB_PASSWORD empty for trust-auth local Postgres.
RPA_DB_HOST=localhost
RPA_DB_PORT=5432
RPA_DB_NAME=rpa
RPA_DB_USER=rpa
RPA_DB_PASSWORD=change_me_or_leave_blank
RPA_DB_SCHEMA=rpa
